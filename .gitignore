# Terraform state. Never committed: it holds resource attributes in plaintext,
# including values read from Secrets Manager and Parameter Store.
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# Provider plugins and module cache
**/.terraform/*
.terraform.tfstate.lock.info

# Variable files may carry account-specific values. Only the example is tracked.
*.auto.tfvars
terraform.tfvars
!terraform.tfvars.example

# Saved plans can contain secrets in cleartext
*.tfplan
*.tfplan.*

# Key material
*.pem
*.key
*.p12
*.pfx

# One exception, by exact path rather than by name. A public key is not a
# secret and CloudFront needs it at plan time. Allowing "!public_key.pem"
# everywhere would let a private key slip through under that name; a full path
# cannot be reached by accident.
!terraform/infrastructures/container-api-ec2/public_key.pem
.env
.env.*
!.env.example

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Applied values, including the repository allowed to deploy
terraform.tfvars
