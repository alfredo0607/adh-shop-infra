xCell id="c74" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8C4FFF;strokeWidth=1.4;fontSize=10;fontColor=#8C4FFF;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;dashPattern=8 5;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c25" target="c34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="812" y="551"/><mxPoint x="812" y="822"/></Array></mxGeometry></mxCell><mxCell id="c75" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8C4FFF;strokeWidth=1.4;fontSize=10;fontColor=#8C4FFF;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;dashPattern=8 5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c34" target="c44"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1326" y="822"/><mxPoint x="1326" y="1018"/></Array></mxGeometry></mxCell><mxCell id="c76" value="How it works" style="fillColor=#FAFAFA;strokeColor=#AAB7B8;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#545B64;whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1915" y="100" width="390" height="1230" as="geometry"/></mxCell><mxCell id="c77" value="&lt;b&gt;Checkout request path&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1935" y="140" width="350" height="22" as="geometry"/></mxCell><mxCell id="c78" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1935" y="170" width="26" height="26" as="geometry"/></mxCell><mxCell id="c79" value="Customers reach the API through &lt;b&gt;Cloudflare&lt;/b&gt;: proxied DNS, TLS, WAF and DDoS protection." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1970" y="164" width="320" height="64" as="geometry"/></mxCell><mxCell id="c80" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1935" y="244" width="26" height="26" as="geometry"/></mxCell><mxCell id="c81" value="The host accepts &lt;b&gt;443 only from Cloudflare's IP ranges&lt;/b&gt;, so nobody can reach it around the edge or forge the client address." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1970" y="238" width="320" height="64" as="geometry"/></mxCell><mxCell id="c82" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1935" y="318" width="26" height="26" as="geometry"/></mxCell><mxCell id="c83" value="&lt;b&gt;nginx&lt;/b&gt; proxies over loopback to the active colour. The idle colour receives the next release." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1970" y="312" width="320" height="64" as="geometry"/></mxCell><mxCell id="c84" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#147EBA;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1935" y="392" width="26" height="26" as="geometry"/></mxCell><mxCell id="c85" value="Rate-limit counters in &lt;b&gt;Valkey&lt;/b&gt;: IAM token auth, TLS, subnets with no internet route." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1970" y="386" width="320" height="64" as="geometry"/></mxCell><mxCell id="c86" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#147EBA;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1935" y="466" width="26" height="26" as="geometry"/></mxCell><mxCell id="c87" value="&lt;b&gt;DynamoDB&lt;/b&gt; through a gateway endpoint: conditional writes stop overselling; each settlement is one TransactWriteItems." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1970" y="460" width="320" height="64" as="geometry"/></mxCell><mxCell id="c88" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DD344C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1935" y="540" width="26" height="26" as="geometry"/></mxCell><mxCell id="c89" value="The API charges a &lt;b&gt;card token&lt;/b&gt; (card data never reaches AWS), signed with the integrity secret, and polls the outcome." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1970" y="534" width="320" height="64" as="geometry"/></mxCell><mxCell id="c90" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DD344C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1935" y="614" width="26" height="26" as="geometry"/></mxCell><mxCell id="c91" value="The gateway pushes &lt;b&gt;signed events&lt;/b&gt; back through Cloudflare to the webhook." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1970" y="608" width="320" height="64" as="geometry"/></mxCell><mxCell id="c92" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#147EBA;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1935" y="688" width="26" height="26" as="geometry"/></mxCell><mxCell id="c93" value="Product images: browser → &lt;b&gt;CloudFront&lt;/b&gt; with a signed, expiring URL → private S3 through Origin Access Control, KMS-encrypted." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1970" y="682" width="320" height="64" as="geometry"/></mxCell><mxCell id="c94" value="&lt;b&gt;Deployment&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1935" y="772" width="350" height="22" as="geometry"/></mxCell><mxCell id="c95" value="A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#8C4FFF;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1935" y="802" width="26" height="26" as="geometry"/></mxCell><mxCell id="c96" value="GitHub Actions assumes an &lt;b&gt;IAM role through OIDC&lt;/b&gt;. No AWS keys are stored in GitHub." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1970" y="796" width="320" height="64" as="geometry"/></mxCell><mxCell id="c97" value="B" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#8C4FFF;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1935" y="876" width="26" height="26" as="geometry"/></mxCell><mxCell id="c98" value="It pushes the image to &lt;b&gt;ECR&lt;/b&gt;, tagged with the commit SHA. Tags are immutable." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1970" y="870" width="320" height="64" as="geometry"/></mxCell><mxCell id="c99" value="C" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#8C4FFF;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1935" y="950" width="26" height="26" as="geometry"/></mxCell><mxCell id="c100" value="&lt;b&gt;SSM Run Command&lt;/b&gt; runs deploy.sh on the host. No SSH, no open admin port needed." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1970" y="944" width="320" height="64" as="geometry"/></mxCell><mxCell id="c101" value="D" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#8C4FFF;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1935" y="1024" width="26" height="26" as="geometry"/></mxCell><mxCell id="c102" value="The host pulls the image, reads /adh-shop/* from &lt;b&gt;Parameter Store&lt;/b&gt;, starts the idle colour and switches only when &lt;b&gt;/ready&lt;/b&gt; reads DynamoDB." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1970" y="1018" width="320" height="64" as="geometry"/></mxCell><mxCell id="c103" value="&lt;b&gt;Lines&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1935" y="1104" width="350" height="22" as="geometry"/></mxCell><mxCell id="c104" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1935" y="1140" width="1" height="1" as="geometry"/></mxCell><mxCell id="c105" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1995" y="1140" width="1" height="1" as="geometry"/></mxCell><mxCell id="c106" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2.0;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c104" target="c105"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c107" value="Customer traffic" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2005" y="1130" width="280" height="20" as="geometry"/></mxCell><mxCell id="c108" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1935" y="1166" width="1" height="1" as="geometry"/></mxCell><mxCell id="c109" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1995" y="1166" width="1" height="1" as="geometry"/></mxCell><mxCell id="c110" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#147EBA;strokeWidth=2.0;fontSize=10;fontColor=#147EBA;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c108" target="c109"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c111" value="Data and images" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2005" y="1156" width="280" height="20" as="geometry"/></mxCell><mxCell id="c112" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1935" y="1192" width="1" height="1" as="geometry"/></mxCell><mxCell id="c113" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1995" y="1192" width="1" height="1" as="geometry"/></mxCell><mxCell id="c114" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DD344C;strokeWidth=2.0;fontSize=10;fontColor=#DD344C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c112" target="c113"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c115" value="Payment gateway" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2005" y="1182" width="280" height="20" as="geometry"/></mxCell><mxCell id="c116" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1935" y="1218" width="1" height="1" as="geometry"/></mxCell><mxCell id="c117" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1995" y="1218" width="1" height="1" as="geometry"/></mxCell><mxCell id="c118" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8C4FFF;strokeWidth=2.0;fontSize=10;fontColor=#8C4FFF;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="c116" target="c117"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c119" value="Deployment and operations" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;