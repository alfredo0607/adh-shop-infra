# Everything here has a working default. Copy this file only to change one.

# SSH is open to the world by default. Narrowing it to your own address is one
# line and removes the brute-force traffic that an open port collects.
# allowed_ssh_cidrs = ["203.0.113.4/32"]

# Provision Valkey for the rate limiter. Roughly 6-7 USD/month; unnecessary
# while there is a single instance.
# enable_cache = true

# instance_type = "t3.small"
