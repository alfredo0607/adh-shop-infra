# Copy to terraform.tfvars.

# Hostname created by add-api.sh on the container host. Setting it makes
# CloudFront serve the API under /api/*, which removes CORS entirely.
# api_origin_domain_name = "api.example.com"

# Payment gateway origin, allowed by the connect-src CSP directive so the
# browser can tokenise the card directly.
# payment_gateway_origin = "https://gateway.example.com"

# Custom domain. The certificate MUST be issued in us-east-1.
# aliases             = ["shop.example.com"]
# acm_certificate_arn = "arn:aws:acm:us-east-1:...:certificate/..."
