# Copy to backend.hcl and fill in the bucket produced by bootstrap/remote-state.
# Partial backend configuration keeps the account id out of version control:
#
#   terraform init -backend-config=../../backend.hcl
#
# The `key` is NOT set here — each stack declares its own in versions.tf, so a
# single shared file cannot cause two stacks to share one state file.

bucket = "adh-shop-terraform-state-<ACCOUNT_ID>"
region = "us-east-1"
